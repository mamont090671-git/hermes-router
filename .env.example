# Primary backend URL (remote GPU server)
HOME_SERVER=http://YOUR_PRIMARY_SERVER:8585

# Fallback backend URL (local laptop/desktop)
LOCAL_LAPTOP=http://YOUR_FALLBACK_SERVER:8080

# Health-check intervals (seconds)
BASE_INTERVAL=5.0
MAX_INTERVAL=60.0

# Connection timeouts (seconds)
CONNECT_TIMEOUT=0.6
READ_TIMEOUT=300

# Max request body size (bytes, default 10MB)
MAX_REQUEST_SIZE=10485760
